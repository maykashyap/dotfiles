# TokyoNight colors for dunst
# For more configuration options see https://github.com/dunst-project/dunst/blob/master/dunstrc

[urgency_low]
    background = "#15161e"
    foreground = "#c0caf5"
    frame_color = "#414868"
    highlight = "#bb9af7"

[urgency_normal]
    background = "#15161e"
    foreground = "#c0caf5"
    frame_color = "#414868"
    highlight = "#bb9af7"

[urgency_critical]
    background = "#292e42"
    foreground = "#db4b4b"
    frame_color = "#db4b4b"

[global]
  follow = mouse
  fullscreen = pushback
  origin = bottom-left
  allow_markup=yes
  offset = (10, 10)
  sort = urgency_ascending
  width = 320
  height = (0,200)
  frame_width = 1 
  progress_bar_frame_width=0
  progress_bar_corner_radius=2
  progress_bar_height=5
  format = <b>%s <big>|</big></b> %b\n<i>%a</i> 󰐱 \n 
  alignment = left
  word_wrap = false
  ellipsize = end
  vertical_alignment = center
  icon_position = left
  max_icon_size = 60 
  notification_limit = 7
  corner_radius = 7
  padding=10
  text_icon_padding=10
  separator_height=1
  gap_size=2
  stack_duplicates=false
  timeout=5
  font = "JetBrainsMono 10"
  icon_corner_radius=5
  mouse_middle_click = do_action,close_current
