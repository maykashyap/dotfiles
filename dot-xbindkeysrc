"~/.config/scripts/volInd.sh -i"
  XF86AudioRaiseVolume
"~/.config/scripts/volInd.sh -d"
  XF86AudioLowerVolume
"xbacklight -inc 10"
  XF86MonBrightnessUp
"xbacklight -dec 10"
  XF86MonBrightnessDown
"~/.config/scripts/asus.sh"
  XF86Launch3
"~/.config/scripts/touchpadDisable.sh"
  m:0x0 + c:199
  release
