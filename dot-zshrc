# Tmux Auto-Attacher/Creator
function tma() {
  if [[ -n "$1" ]]; then
    # Case 1: Argument provided
    if tmux has-session -t "$1" 2>/dev/null; then
      # Check if session is already attached
      local is_attached=$(tmux display-message -p -t "$1" '#{session_attached}')
      if [[ "$is_attached" -gt 0 ]]; then
        echo "Error: Session '$1' is already attached elsewhere."
        return 1
      else
        tmux attach -t "$1"
      fi
    else
      # Create new session with provided name
      tmux new -s "$1"
    fi
  else
    # Case 2: No argument provided
    # Find the first session that has 0 attachments
    local unattached_session=$(tmux list-sessions -F '#{session_name} #{session_attached}' 2>/dev/null | awk '$2 == 0 {print $1; exit}')

    if [[ -n "$unattached_session" ]]; then
      tmux attach -t "$unattached_session"
    else
      # No unattached sessions exist, start a new unnamed one
      tmux new
    fi
  fi
}
