# Aliases
function vol ()
{
  pamixer --set-volume=$1
}
function ibl ()
{
  xbacklight -set $1
}
function dbl ()
{
  ddcutil setvcp 10 $1
}
function bl (){
  xbacklight -set $1
  ddcutil setvcp 10 $1
}
funtion floating (){
  $1 &
  sleep 0.5
  i3-msg "$(xprop -root | awk '/WM_CLASS\(STRINGS\)/{print $NF}') floating enable"
}
alias logout="i3-msg exit"
alias ls="eza --color=always --long --git --icons=always --no-user --no-permissions --all"
funtion lt(){
  eza --color=always --long --git --icons=always --no-user --all --tree --level $1 --no-permissions
}
function tma () {
  tmux attach -t $1
}
alias obsidiansync="~/.config/scripts/zsh/ObsidianSync.sh"
alias clock="tty-clock -S -n -c"
function kbl (){
  setxkbmap $1
  echo "Current Keyboard Layout set to: $(setxkbmap -query | grep layout | awk '{ print $2 }')" 
}
alias nsr="nvim +SessionRestore"
alias adbport="adb forward tcp:8022 tcp:8022"

